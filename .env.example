# Public site URL used for canonical links, sitemap, Open Graph, and payment return URLs.
# Example: https://example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Phase 2) — from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only — required for payment webhooks to write payment status
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Payments (Phase 3) — set NEXT_PUBLIC_PAYMENT_PROVIDER to stripe or razorpay
NEXT_PUBLIC_PAYMENT_PROVIDER=stripe

# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook
# Optional: use Stripe Dashboard Price IDs instead of amount/currency in config
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_PRO=price_...

# Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your-key
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook
# Required for Razorpay subscriptions (create the plan in Razorpay)
# RAZORPAY_PLAN_PRO=plan_...

# Optional modules (Phase 5) — also toggle flags in src/config/modules.ts
# Analytics
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yourdomain.com
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX
# Email (Resend) — contact form
# RESEND_API_KEY=re_your-resend-key
# EMAIL_FROM=LaunchKit <hello@your-domain.com>
# EMAIL_TO=hello@example.com
# Admin — comma-separated emails treated as admins (or set profiles.role = admin)
# ADMIN_EMAILS=you@example.com
# Optional extra database (auth stays on Supabase)
# MONGODB_URI=mongodb+srv://...
# MONGODB_DB_NAME=launchkit


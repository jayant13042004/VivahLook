# VivahLook Environment Variables
# Copy this file to .env.local and fill in your values.

# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Payment Gateway (Razorpay only for MVP)
NEXT_PUBLIC_PAYMENT_PROVIDER=razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your-key
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook

# AI Image Generation (Google Gemini)
GEMINI_API_KEY=your-gemini-api-key

# Analytics (optional)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=vivahlook.com
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX

# Email (Resend) — for contact form
# RESEND_API_KEY=re_your-resend-key
# EMAIL_FROM=VivahLook <hello@vivahlook.com>
# EMAIL_TO=hello@vivahlook.com

# Admin
# ADMIN_EMAILS=you@example.com
